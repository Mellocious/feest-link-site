link.usefeest.com {
    # Dynamic routes → FastAPI
    handle /card/* {
        reverse_proxy api:8000
    }
    handle /brnch {
        reverse_proxy api:8000
    }
    handle /rlpban {
        reverse_proxy api:8000
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /xadmin* {
        reverse_proxy api:8000
    }

    # Static files (main links page)
    handle {
        root * /srv/link
        file_server
        try_files {path} /index.html
    }

    encode gzip
}
